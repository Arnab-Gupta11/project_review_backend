NODE_ENV=development
PORT=5000

# PostgreSQL Configuration
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=project_review_db
DB_PORT=5433
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/project_review_db?schema=public

JWT_SECRET=super_secret_jwt_key_that_is_at_least_32_characters_long
JWT_EXPIRES_IN=7d
COOKIE_SECRET=super_secret_cookie_key_that_is_at_least_32_characters_long

CLIENT_URL=http://localhost:3000
